  "rewrites": {
   "3": {
    "original": "Bri Thomas scored at 49:49 to put the Cardinals on top for good, and the Wildcats scored again in the 82nd minute, giving them 21 shots to just eight for the Matadors, who went down to their first defeat (9-1) after starting the season 7-0.",
    "rewrite": "At 49:49, Bri Thomas scored to ensure the Cardinals led from then on, and the Wildcats added another goal in the 82nd minute, resulting in the Cardinals having 21 shots compared to just eight for the Matadors. The Matadors, starting the season 7-0, suffered their first loss (9-1)."
   },
   "1": {
    "original": "EL PASO \u2014 Belinda Lordo and Lino Arciniega scored goals, but the Lamar South Plains College defeated Western Texas College 3-2 in Western Junior College Athletic Conference action.",
    "rewrite": "EL PASO \u2014 Despite goals from Belinda Lordo and Lino Arciniega, Western Texas College lost to Lamar South Plains College 3-2 in Western Junior College Athletic Conference action."
   },
   "0": {
