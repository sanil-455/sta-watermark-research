  "rewrites": {
   "1": {
    "original": "We want to let the communities do the responsibility for generating the data in their countries and the regions over and above any governments that want to provide their own public health data.",
    "rewrite": "We aim to allow communities to take charge of generating data for their countries and regions, in addition to any governments willing to share their public health data."
   },
   "2": {
    "original": "In the short-run, I think there are very different challenges according to the stage each country faces in their response to air pollution.",
    "rewrite": "Within a short time frame, it appears that each country encounters distinct challenges based on their respective stages of addressing air pollution."
   },
