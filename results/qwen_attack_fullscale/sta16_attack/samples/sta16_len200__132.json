  "rewrites": {
   "2": {
    "original": "There are at 6 p.m. Monday at the Village Green in Historic Dublin; and the Concert on the Green at 7 p.m. at the Sycamore Park Amphitheater, at North High Street and River Road.",
    "rewrite": "The concert at 6 p.m. Monday is at the Village Green in Historic Dublin, followed by another concert at 7 p.m. at the Sycamore Park Amphitheater on North High Street and River Road."
