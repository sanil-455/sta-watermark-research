  "rewrites": {
   "10": {
    "original": "Suspicions are so high about Taliban rivalries that in a conspiracy theory tweeted on Tuesday a source close to Mullah Mansoor, the Taliban leader, was accused of leaking the Kabul government news to embarrass a rival Taliban faction.",
    "rewrite": "Conspiratorial suspicions about Taliban tensions are so prevalent that on Tuesday, a tweet alleged a confidant of Taliban leader Mullah Mansoor had disclosed Kabul government information to diminish the stature of a competing Taliban group."
   },
   "1": {
    "original": "Mansoor is reportedly a close confidante of Pakistan's military and intelligence agencies as well as of the Afghan government and the Pakistanis and Afghans together are trying to engage him in an amnesty program for the insurgency.",
    "rewrite": "It is reportedly rumored that Mansoor has a close relationship with Pakistan's military and intelligence agencies and the Afghan government, and together they are attempting to involve him in an amnesty plan for those in the insurgency."
   },
   "11": {
    "original": "While the Taliban appeared to have not checked the night-time meeting invitation and thus suffered the wrath of the Quetta police, a senior Quetta police official told Al Jazeera that \"both sides\" trusted each other.",
