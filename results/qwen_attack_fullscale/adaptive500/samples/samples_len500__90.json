  "rewrites": {
   "9": {
    "original": "In an effort to promote his recent album 'Shiny & Oh So Bright, Vol 1' - Pumpkins singer and guitarist Billy Corgan had asked Kanye to deliver what he describes as \"a Pumpkins moment\" during his Sunday Service show held at the Hollywood Bowl on April 21.",
    "rewrite": "Billy Corgan, the singer and guitarist from the band Pumpkins, requested that Kanye West deliver what he characterized as \"a Pumpkins moment\" during his April 21 show at the Hollywood Bowl, which coincided with the promotion of his new album 'Shiny & Oh So Bright, Vol 1'."
   },
   "7": {
    "original": "The 'Du Thomas' rapper's recent work included lending his vocals to Skrillex during the DJ's 13-minute set at Coachella.",
    "rewrite": "The rap artist associated with 'Du Thomas' contributed his voice to Skrillex during the DJ\u2019s 13-minute performance at Coachella."
   },
   "8": {
    "original": "Kanye, meanwhile, returned to songwriting earlier this month after he parted ways with The Smashing Pumpkins.",
    "rewrite": "Meanwhile, Kanye ventured back into songwriting at the beginning of this month following his departure from The Smashing Pumpkins."
   },
   "1": {
    "original": "Kanye has also previously revealed that he has collaborated with Kid Cudi, 37, on the project.",
    "rewrite": "Kanye has previously disclosed collaborating with Kid Cudi, who is 37, on the project."
   },
   "6": {
    "original": "Representatives for Kanye and Dua have been contacted about the collaboration.",
