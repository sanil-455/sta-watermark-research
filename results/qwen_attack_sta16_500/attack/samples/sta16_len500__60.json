    "original": "Truphone\u2019s sponsorship agreement with Caterham is different from that of other sponsors.",
    "rewrite": "Truphone\u2019s sponsorship deal with Caterham differs from others\u2019 sponsorships."
   },
   "9": {
    "original": "Before, all data from the car is usually stored in a single location.",
    "rewrite": "Previously, most vehicle data was typically kept in one place."
   }
