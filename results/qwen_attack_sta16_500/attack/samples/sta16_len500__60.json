  "rewrites": {
   "14": {
    "original": "John Marsh, global head of applications for Caterham, arrived when he was asked to ensure the IT systems remained fit for purpose whilst complying with Formula One regulation, and he immediately made provisioning a priority.",
    "rewrite": "John Marsh, Caterham's global head of applications, came on board to ensure that the IT systems stayed compliant with Formula One regulations and functioning as needed, with provisioning becoming his top priority from the outset."
   },
   "4": {
    "original": "As well as providing communications support, Truphone gives paid access to its products and services to Caterham\u2019s employees, according to David Powers, global director of partnerships for Truphone.",
    "rewrite": "In addition to offering communications assistance, Truphone supplies financial access to its offerings to Caterham\u2019s workers, as stated by David Powers, global partnerships director at Truphone."
   },
   "13": {
