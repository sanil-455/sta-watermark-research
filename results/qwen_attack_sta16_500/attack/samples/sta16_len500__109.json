  "rewrites": {
   "7": {
    "original": "In the meantime, America's leading missile-defense contractor, Boeing, announced in February that it had struck a contract with the Pentagon to deliver components for an advanced missile interceptor being built in Maryland.",
    "rewrite": "Meanwhile, Boeing, America's foremost missile defense contractor, disclosed in February a deal with the Pentagon to supply components for an advanced missile interceptor under construction in Maryland."
   },
   "4": {
    "original": "One particularly concerning advanced Russian cruise missile's range far exceeds anything the Pentagon would need to defend the continental United States, but would instead cover its overseas territories such as Europe.",
    "rewrite": "One notably worrisome Russian advanced cruise missile has a range that surpasses what the Pentagon needs for defending the continental U.S., extending instead to include overseas areas like Europe."
   },
   "8": {
    "original": "One such interceptor will be included in a new missile-defense system plundered nearly $1 billion and due to be completed in Romania sometime before the end of the year, according to the MDA.",
