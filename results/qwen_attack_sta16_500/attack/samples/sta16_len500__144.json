  "rewrites": {
   "21": {
    "original": "Clients sign initial nine-month contracts and may live in any of Silicon Valley\u2019s 452 square miles in order to qualify (the Hill Bar at the Rosewood hosting parties is located in Woodside, part of San Mateo County).",
    "rewrite": "Parties are hosted at the Hill Bar at the Rosewood, situated in Woodside within San Mateo County, for clients who have signed initial nine-month contracts and reside anywhere across Silicon Valley's 452 square miles to be eligible."
