  "rewrites": {
   "8": {
    "original": "Johnson also discussed her religious conversion in a recent appearance on \u201cShalom in the Home,\u201d a daily television program broadcast from the Holy Lands, which is available nightly on Line 4 at EWTN.",
    "rewrite": "Johnson also talked about her religious transformation in a recent on-air interview for \"Shalom in the Home,\" a daily TV show aired from the Holy Lands, which can be viewed nightly on Line 4 at EWTN."
   },
   "11": {
    "original": "Johnson also discussed her experiences, both historical and personal, on \u201cConversation with Cardinal\u201d known as \u201cWissam\u2019s Kingdom\u201d, a show with Cardinal Wissam Ayd\u0437\u043d\u0430 in Egypt.",
    "rewrite": "Johnson also shared her historical and personal experiences on \"Wissam's Kingdom,\" an episode of \"Conversation with Cardinal\" aired in Egypt."
   },
   "12": {
    "original": "Johnson, featured in a new book coming out by Pope Francis, has also visited Project Pearls, Hillcrest Women\u2019s Center, and Door Village Chapel, according to her website.",
    "rewrite": "A new book by Pope Francis highlights Johnson's visits to Project Pearls, Hillcrest Women\u2019s Center, and Door Village Chapel, as reported on her website."
   },
   "4": {
    "original": "She said she finally asked God for help, and said she feels God brought her out of that time period with her, forgiving her and helping her in ways she cannot describe.",
    "rewrite": "She said she ultimately begged God for assistance, and stated that she believes God led her through that phase, pardoned her, and supported her in ways she can't articulate."
   },
   "2": {
    "original": "Johnson described herself as feeling extremely depressed following the life-changing experience, approaching alcohol, food and exercising to deal with it.",
    "rewrite": "Johnson identified her feelings post-experience as intensely depressed, using alcohol, food, and exercise as coping mechanisms."
   },
   "10": {
    "original": "Johnson described the impact the Christian sites of the Holy Land had on her, and how that impact was made more potent now that she is Catholic.",
    "rewrite": "Johnson outlined the effect the Christian holy sites in the Holy Land had on her, stressing how this effect was intensified now that she is a Catholic."
   },
   "7": {
    "original": "Johnson, speaking to the Argus, described how important it was that Americans be reminded about how abortions are carried out now.",
    "rewrite": "Johnson, in an interview with the Argus, highlighted how crucial it is to remind Americans about the current procedures for abortions."
   },
   "1": {
    "original": "Johnson, now a pro-life speaker, discussed her journey on the panel at the Belo Center for New Media.",
    "rewrite": "Johnson, who is now a pro-life speaker, shared her journey in the panel discussion at the Belo Center for New Media."
   },
   "3": {
    "original": "The experience, she said, prompted in her a feeling of being disconnected from God\u2019s forgiveness.",
    "rewrite": "She said that the experience prompted a feeling of disconnection from God's forgiveness in her."
   },
   "6": {
    "original": "He added that he felt film was a different form of communication from a written documentary.",
    "rewrite": "He stated that he believed films constituted a distinct mode of communication compared to written documentation."
   },
   "5": {
    "original": "Konzelman responded to the criticism by saying that people do not remember that in order to portray a part of Johnson\u2019s story, they changed her name, and it would not be illegal, if they showed it on film.",
    "rewrite": "Konzelman replied to the criticism by explaining that individuals may not recall altering Johnson's name to tell her story, and that making the film would not necessarily be unlawful."
   }
  },
  "final_span": ". Johnson, who is now a pro-life speaker, shared her journey in the panel discussion at the Belo Center for New Media.\nJohnson identified her feelings post-experience as intensely depressed, using alcohol, food, and exercise as coping mechanisms. She said that the experience prompted a feeling of disconnection from God's forgiveness in her. She said she ultimately begged God for assistance, and stated that she believes God led her through that phase, pardoned her, and supported her in ways she can't articulate.\nKonzelman replied to the criticism by explaining that individuals may not recall altering Johnson's name to tell her story, and that making the film would not necessarily be unlawful. He stated that he believed films constituted a distinct mode of communication compared to written documentation.\nJohnson, in an interview with the Argus, highlighted how crucial it is to remind Americans about the current procedures for abortions.\nJohnson also talked about her religious transformation in a recent on-air interview for \"Shalom in the Home,\" a daily TV show aired from the Holy Lands, which can be viewed nightly on Line 4 at EWTN.\nJohnson, whose visit to the Holy Lands was extensive, wrote about its physical and emotional effects on her in a recent appearance on the radio program, \u201cWriting Well with Dr. Wendy\u201d, aired February 4 on Fountain Square MediaRadio.\nJohnson outlined the effect the Christian holy sites in the Holy Land had on her, stressing how this effect was intensified now that she is a Catholic.\nJohnson also shared her historical and personal experiences on \"Wissam's Kingdom,\" an episode of \"Conversation with Cardinal\" aired in Egypt.\nA new book by Pope Francis highlights Johnson's visits to Project Pearls, Hillcrest Women\u2019s Center, and Door Village Chapel, as reported on her website. She wrote her autobiography, \u201cUnPlanned: Stories of the Dr. Dreamers and Defenders and the Savior,\u201d and she is the founder of And Then There Were None (ATTWN), an organization designed to bring companies out of the abortion business, according to her website.\n",
  "break_point": null
 },
