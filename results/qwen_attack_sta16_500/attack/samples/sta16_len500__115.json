  "rewrites": {
   "6": {
    "original": "In a blow to the SAF's F-15 in a 2017 re-organisation which saw more F-15s retire, Prime Minister Lee Hsien Loong announced in February that a new naval unit of F-35B stealth fighter jets, built by the Americans, will be deployed here.",
    "rewrite": "A setback for the SAF's F-15 during the 2017 restructuring, where numerous F-15s were retired, occurred when Prime Minister Lee Hsien Loong, in February, disclosed the deployment of a novel naval unit comprising F-35B stealth fighter jets, manufactured by the Americans."
   },
   "5": {
    "original": "Singapore sought additional training areas when it bought the F-15s from the United States in 2014 for SG$7.6 billion (US$5.7 billion).",
    "rewrite": "In 2014, Singapore purchased F-15s from the United States for SG$7.6 billion (US$5.7 billion) and looked for additional training sites."
   },
   "7": {
    "original": "Cheers at the news were tempered with disappointment over the loss of the F-15 in Singapore's defence force.",
    "rewrite": "Supportive cheers for the news were marred by dismay at the F-15 fighter's removal from Singapore's defense fleet."
   }
